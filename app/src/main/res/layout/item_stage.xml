<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="120dp">

    <LinearLayout
        android:id="@+id/layout_stars"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintBottom_toTopOf="@id/btn_single_stage"
        app:layout_constraintStart_toStartOf="@id/btn_single_stage"
        app:layout_constraintEnd_toEndOf="@id/btn_single_stage"
        android:layout_marginBottom="4dp">

        <ImageView
            android:id="@+id/iv_star1"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@android:drawable/star_off" />

        <ImageView
            android:id="@+id/iv_star2"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@android:drawable/star_off" />

        <ImageView
            android:id="@+id/iv_star3"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@android:drawable/star_off" />
    </LinearLayout>

    <Button
        android:id="@+id/btn_single_stage"
        android:layout_width="80dp"
        android:layout_height="80dp"
        app:backgroundTint="@null"
        android:background="@drawable/bg_stage_button"
        android:text="1"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5" />

</androidx.constraintlayout.widget.ConstraintLayout>