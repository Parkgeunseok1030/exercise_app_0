<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="30dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="운동 완료!"
            android:textColor="#FFFFFF"
            android:textSize="32sp"
            android:textStyle="bold"
            android:layout_marginBottom="40dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#1E1E1E"
            android:padding="20dp">

            <TextView
                android:id="@+id/tv_res_total"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="총 횟수: 0회"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:layout_marginBottom="10dp"/>

            <TextView
                android:id="@+id/tv_res_perfect"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PERFECT: 0회"
                android:textColor="#4CAF50"
                android:textSize="18sp"
                android:layout_marginBottom="5dp"/>

            <TextView
                android:id="@+id/tv_res_good"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="GOOD: 0회"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:layout_marginBottom="20dp"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#333333"
                android:layout_marginBottom="20dp"/>

            <TextView
                android:id="@+id/tv_res_xp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="획득 경험치: +0 XP"
                android:textColor="#FFEB3B"
                android:textSize="24sp"
                android:textStyle="bold"/>
        </LinearLayout>

        <Button
            android:id="@+id/btn_go_home"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="50dp"
            android:text="홈으로 돌아가기"
            android:backgroundTint="#2196F3"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:padding="15dp"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layout_stars_result"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_centerInParent="true"
        android:visibility="gone">

        <ImageView
            android:id="@+id/iv_res_star1"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:src="@android:drawable/star_big_on"
            app:tint="#FFD700"
            android:layout_margin="10dp"
            android:alpha="0"
            android:scaleX="0"
            android:scaleY="0"
            android:elevation="10dp"/>

        <ImageView
            android:id="@+id/iv_res_star2"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:src="@android:drawable/star_big_on"
            app:tint="#FFD700"
            android:layout_margin="10dp"
            android:alpha="0"
            android:scaleX="0"
            android:scaleY="0"
            android:elevation="10dp"/>

        <ImageView
            android:id="@+id/iv_res_star3"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:src="@android:drawable/star_big_on"
            app:tint="#FFD700"
            android:layout_margin="10dp"
            android:alpha="0"
            android:scaleX="0"
            android:scaleY="0"
            android:elevation="10dp"/>
    </LinearLayout>

</RelativeLayout>