<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F1F8E9"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="운동 난이도 설정"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="#2E7D32"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="내 체력에 맞는 단계를 선택해 주세요.\n판정 기준과 목표치가 조정됩니다."
        android:textSize="14sp"
        android:lineSpacingExtra="4dp"
        android:textColor="#666666"
        android:layout_marginBottom="32dp"/>

    <RadioGroup
        android:id="@+id/rg_difficulty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <RadioButton
            android:id="@+id/rb_level1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:button="@null"
            android:background="@drawable/bg_difficulty_item"
            android:text="🟢  초급 (1단계)\n목표 횟수 적음, 각도 판정 너그러움"
            android:textSize="16sp"
            android:textColor="#444444"
            android:padding="20dp"
            android:layout_marginBottom="16dp"
            android:elevation="2dp"
            android:buttonTint="#4CAF50"/>

        <RadioButton
            android:id="@+id/rb_level2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:button="@null"
            android:background="@drawable/bg_difficulty_item"
            android:text="🟡  중급 (2단계)\n목표 횟수 보통, 각도 판정 보통"
            android:textSize="16sp"
            android:textColor="#444444"
            android:padding="20dp"
            android:layout_marginBottom="16dp"
            android:elevation="2dp"
            android:buttonTint="#FFC107"/>

        <RadioButton
            android:id="@+id/rb_level3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:button="@null"
            android:background="@drawable/bg_difficulty_item"
            android:text="🔴  고급 (3단계)\n목표 횟수 많음, 각도 판정 엄격함"
            android:textSize="16sp"
            android:textColor="#444444"
            android:padding="20dp"
            android:layout_marginBottom="40dp"
            android:elevation="2dp"
            android:buttonTint="#F44336"/>
    </RadioGroup>

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btn_save_difficulty"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="설정 저장하기"
        android:textSize="18sp"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:background="@drawable/circle_background"
        android:backgroundTint="#4CAF50"
        android:elevation="4dp"/>

    <TextView
        android:id="@+id/btn_cancel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:text="취소하고 돌아가기"
        android:textSize="15sp"
        android:textColor="#999999"
        android:layout_marginTop="20dp"
        android:padding="10dp"
        android:background="?attr/selectableItemBackground"/>

</LinearLayout>